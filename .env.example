# ─── Cognify root env ───────────────────────────────────
# Copy to .env for local development:  copy .env.example .env  (Windows)
#                                       cp .env.example .env    (macOS/Linux)

# Environment
ENV=development
LOG_LEVEL=info

# ─── Service URLs (local dev) ─────────────────────────────
CORE_BACKEND_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8001
EXECUTION_SERVICE_URL=http://localhost:8002
WEB_URL=http://localhost:3000

# ─── Web frontend (read at dev/build time by apps/web) ──────
NEXT_PUBLIC_CORE_BACKEND_URL=http://localhost:8000

# ─── Service ports ────────────────────────────────────────
CORE_BACKEND_PORT=8000
AI_SERVICE_PORT=8001
EXECUTION_SERVICE_PORT=8002
WEB_PORT=3000

# ─── Database (provisioned later — not used yet) ──────────
DATABASE_URL=postgresql+asyncpg://cognify:cognify@localhost:5432/cognify
REDIS_URL=redis://localhost:6379/0

# ─── Auth (provisioned later — not used yet) ──────────────
JWT_SECRET=change-me-in-local-env-only
JWT_EXPIRE_MINUTES=60

# ─── LLM (used later by ai-service only — not used yet) ───
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
