# ai-service local env (copy to .env)
# Step 7: AI diagnosis — LLM sees ONLY the EvidencePack (no DB access).
# Keep secrets in the environment; never hard-code API keys in code.
ENV=development
LOG_LEVEL=info
PORT=8001
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=
CORE_BACKEND_URL=http://localhost:8000
